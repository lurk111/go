# Documentation only; init generates independent random credentials.
COMPOSE_PROJECT_NAME=bid-mon
BID_MON_MODE=business
BID_MON_IMAGE=bid-mon:2.0.0-dev
BID_MON_LAB_IMAGE=bid-mon-lab:2.0.0-dev
BID_MON_SSH_IMAGE=bid-mon-go-ssh:2.0.0-dev
BID_MON_BIND_ADDRESS=127.0.0.1
BID_MON_HTTP_PORT=18080
BID_MON_UID=10001
BID_MON_GID=10001
# Required secrets are generated, never copy credentials from another instance.
# POSTGRES_PASSWORD, MON_ADMIN_TOKEN, MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD,
# MONITOR_MYSQL_PASSWORD
# Optional: MON_MODEL_CONFIG_FILE=/etc/bid-mon/model.json
