MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MONITOR_MYSQL_PASSWORD=
POSTGRES_PASSWORD=
MON_ADMIN_TOKEN=

# Go monitor settings; model configuration is optional and stored in a separate private file.
MON_DIAGNOSIS_ENABLED=true
MON_DIAGNOSIS_TIMEOUT_SECONDS=120
MON_POLL_SECONDS=15
MON_QUEUE_SECONDS=180
MON_STALE_SECONDS=900
MON_RESULT_GRACE_SECONDS=30
# Set to /run/secrets/model.json to enable the local deploy/model.local.json file.
MON_MODEL_CONFIG_FILE=
